# autovideo-master - File mau cau hinh bien moi truong (API Keys)
# Doi ten thanh .env va dien khoa API cua ban vao

# Groq Cloud API Key (Dung cho bóc giọng nói Whisper siêu tốc 3-5s - Bat buoc)
# Lay khoa mien phi tai: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ElevenLabs API Key (Tuy chon: neu muon dung giong doc cao cap tra phi)
# Lay khoa tai: https://elevenlabs.io
ELEVENLABS_API_KEY=

# Pexels API Key (Tuy chon: neu muon tu dong tim B-roll tu Pexels)
# Lay khoa mien phi tai: https://www.pexels.com/api/
PEXELS_API_KEY=
